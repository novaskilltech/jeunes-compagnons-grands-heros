{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/assets/livre.pdf", "headers": [{ "key": "Content-Type", "value": "application/pdf" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
